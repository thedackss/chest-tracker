<?xml version="1.0" encoding="utf-8"?>
<!-- Paste into SignPath: project chest-tracker > Artifact configurations. The GitHub artifact is a zip holding the exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="ChestTracker.exe" product-name="chest-tracker" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
