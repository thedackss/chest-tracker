<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:ChestTracker.Ui"
             x:Class="ChestTracker.Ui.MatchesPage">
  <UserControl.Styles>
    <Style Selector="TextBlock.n">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="Grid.row > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{ui:Tr Matches, Partidas}" />
        <TextBlock x:Name="Summary" Classes="muted" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="OpenFolderButton" Content="{ui:Tr 'Open data folder', 'Abrir carpeta de datos'}" />
        <Button x:Name="ExportButton" Classes="accent" Content="{ui:Tr 'Export report', 'Exportar informe'}" />
      </StackPanel>
    </Grid>
    <Border Classes="card">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Classes="row" ColumnDefinitions="148,1.4*,62,52,58,58,64,1.2*" ColumnSpacing="8" Margin="16,10">
          <TextBlock Classes="h3" Text="{ui:Tr When, Cuándo, Upper=True}" />
          <TextBlock Grid.Column="1" Classes="h3" Text="{ui:Tr Mode, Modo, Upper=True}" />
          <TextBlock Grid.Column="2" Classes="h3 n" Text="{ui:Tr Place, Puesto, Upper=True}" />
          <TextBlock Grid.Column="3" Classes="h3 n" Text="{ui:Tr Total, Total, Upper=True}" />
          <TextBlock Grid.Column="4" Classes="h3 n" Text="{ui:Tr Quest, Misión, Upper=True}" />
          <TextBlock Grid.Column="5" Classes="h3 n" Text="{ui:Tr Broken, Rotos, Upper=True}" />
          <TextBlock Grid.Column="6" Classes="h3 n" Text="{ui:Tr Buried, Enterr., Upper=True}" />
          <TextBlock Grid.Column="7" Classes="h3" Text="{ui:Tr Treasures, Tesoros, Upper=True}" Margin="10,0,0,0" />
        </Grid>
        <Border DockPanel.Dock="Top" Classes="sep" />
        <Panel>
          <TextBlock x:Name="Empty" Classes="muted" Margin="16" IsVisible="False"
                     Text="{ui:Tr 'No match yet. Play a match with replays turned on.', 'Aún no hay partidas. Juega una con las repeticiones activadas.'}" />
          <ScrollViewer>
            <ItemsControl x:Name="Rows">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ui:MatchRow">
                  <Border BorderBrush="{DynamicResource CtLine}" BorderThickness="0,0,0,1">
                    <Grid Classes="row" ColumnDefinitions="148,1.4*,62,52,58,58,64,1.2*" ColumnSpacing="8" Margin="16,8">
                      <TextBlock Text="{Binding When}" />
                      <TextBlock Grid.Column="1" Text="{Binding Mode}" Classes="muted" />
                      <TextBlock Grid.Column="2" Text="{Binding Place}" Classes="n" />
                      <TextBlock Grid.Column="3" Text="{Binding Total}" Classes="n num gold" FontSize="16" />
                      <TextBlock Grid.Column="4" Text="{Binding Quest}" Classes="n" />
                      <TextBlock Grid.Column="5" Text="{Binding Broken}" Classes="n" />
                      <TextBlock Grid.Column="6" Text="{Binding Buried}" Classes="n" />
                      <TextBlock Grid.Column="7" Text="{Binding Treasures}" Classes="small star" Margin="10,0,0,0"
                                 ToolTip.Tip="{Binding Treasures}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
