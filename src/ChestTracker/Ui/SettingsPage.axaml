<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:ChestTracker.Ui"
             x:Class="ChestTracker.Ui.SettingsPage">
  <UserControl.Styles>
    <Style Selector="Grid.srow">
      <Setter Property="Margin" Value="0,9" />
      <Setter Property="ColumnSpacing" Value="14" />
    </Style>
    <Style Selector="Grid.srow > TextBlock, Grid.srow > StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,280" ColumnSpacing="16">
    <ScrollViewer>
      <StackPanel Spacing="10" Margin="0,0,8,0">
        <TextBlock Classes="h3" Text="{ui:Tr General, General, Upper=True}" />
        <Border Classes="card" Padding="16,2">
          <StackPanel>
            <Grid Classes="srow" ColumnDefinitions="*,Auto">
              <TextBlock Text="{ui:Tr Language, Idioma}" />
              <ComboBox Grid.Column="1" x:Name="LanguageBox" Width="150">
                <ComboBoxItem>English</ComboBoxItem>
                <ComboBoxItem>Español</ComboBoxItem>
              </ComboBox>
            </Grid>
            <Border Classes="sep" />
            <Grid Classes="srow" ColumnDefinitions="*,Auto">
              <TextBlock Text="{ui:Tr Theme, Tema}" />
              <Border Grid.Column="1" Classes="seg">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton x:Name="ThemeSystem" Theme="{StaticResource CtSegment}" GroupName="theme" Content="{ui:Tr System, Sistema}" />
                  <RadioButton x:Name="ThemeDark" Theme="{StaticResource CtSegment}" GroupName="theme" Content="{ui:Tr Dark, Oscuro}" />
                  <RadioButton x:Name="ThemeLight" Theme="{StaticResource CtSegment}" GroupName="theme" Content="{ui:Tr Light, Claro}" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="sep" />
            <Grid Classes="srow" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{ui:Tr 'Start with Windows', 'Iniciar con Windows'}" />
                <TextBlock Classes="small" Text="{ui:Tr 'Waits in the tray until Fortnite starts', 'Espera en la bandeja hasta que abras Fortnite'}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" x:Name="AutostartSwitch" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="h3" Margin="0,6,0,0" Text="{ui:Tr Quest, Misión, Upper=True}" />
        <Border Classes="card" Padding="16,2">
          <StackPanel>
            <Grid Classes="srow" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="{ui:Tr 'Your “Open treasure chests” quest is at', 'Tu misión “Abre cofres de tesoro” va en'}" />
                <TextBlock x:Name="QuestInfo" Classes="small" TextWrapping="Wrap" />
              </StackPanel>
              <NumericUpDown Grid.Column="1" x:Name="QuestBox" Width="140" Minimum="0" Maximum="1000000" Increment="1"
                             FormatString="N0" ParsingNumberStyle="Number" ClipValueToMinMax="True" />
            </Grid>
            <Border Classes="sep" />
            <StackPanel Margin="0,9" Spacing="6">
              <TextBlock Text="{ui:Tr 'Replays folder', 'Carpeta de repeticiones'}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="FolderBox" FontSize="12" />
                <Button Grid.Column="1" x:Name="BrowseButton" Content="{ui:Tr Browse, Examinar}" />
              </Grid>
              <TextBlock x:Name="FolderInfo" Classes="small" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Classes="h3" Margin="0,6,0,0" Text="{ui:Tr Overlay, Overlay, Upper=True}" />
        <Border Classes="card" Padding="16,2">
          <StackPanel>
            <Grid Classes="srow" ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{ui:Tr 'Show overlay', 'Mostrar overlay'}" />
                <Border Classes="kbd"><TextBlock Text="Ctrl+Shift+O" /></Border>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" x:Name="OverlaySwitch" />
            </Grid>
            <Border Classes="sep" />
            <Grid Classes="srow" ColumnDefinitions="*,Auto">
              <TextBlock Text="{ui:Tr 'Only while Fortnite is running', 'Solo mientras Fortnite está abierto'}" />
              <ToggleSwitch Grid.Column="1" x:Name="InGameSwitch" />
            </Grid>
            <Border Classes="sep" />
            <Grid Classes="srow" ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="{ui:Tr Size, Tamaño}" />
              <Slider Grid.Column="1" x:Name="SizeSlider" Width="170" Minimum="50" Maximum="200" TickFrequency="5"
                      IsSnapToTickEnabled="True" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" x:Name="SizeText" Width="48" TextAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto" Margin="2,6,0,4">
          <TextBlock x:Name="AboutText" Classes="small" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="DataFolderButton" Classes="link" Content="{ui:Tr 'Open data folder', 'Abrir carpeta de datos'}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" Classes="card" Padding="14" VerticalAlignment="Top">
      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="{ui:Tr 'Overlay preview', 'Vista previa del overlay', Upper=True}" />
        <Border Height="230" CornerRadius="8" ClipToBounds="True">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Offset="0" Color="#5d7f9e" />
              <GradientStop Offset="0.38" Color="#8aa7b5" />
              <GradientStop Offset="0.39" Color="#5f7d4c" />
              <GradientStop Offset="1" Color="#3e5a33" />
            </LinearGradientBrush>
          </Border.Background>
          <Panel>
            <Border Width="64" Height="64" CornerRadius="4" Background="#2c4f37" BorderBrush="#80ffffff" BorderThickness="2"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
            <Image x:Name="OverlayImage" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,78,4,0"
                   Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="244" MaxHeight="148" />
          </Panel>
        </Border>
        <Button x:Name="LockButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <TextBlock Classes="small" TextWrapping="Wrap"
                   Text="{ui:Tr 'Shows over Fortnite in Windowed Fullscreen (Settings → Video → Window Mode). Unlocked, drag it where you want.', 'Se ve sobre Fortnite en Pantalla completa en ventana (Ajustes → Vídeo → Modo de ventana). Sin fijar, arrástralo donde quieras.'}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
