<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:ChestTracker.Ui"
             x:Class="ChestTracker.Ui.WelcomeView">
  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="{DynamicResource CtOn}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.step > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CtInk}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <StackPanel Margin="36,28" Spacing="14">
    <StackPanel Spacing="4">
      <ui:ChestIcon Width="76" Height="66" HorizontalAlignment="Center" />
      <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"
                 Text="{ui:Tr 'Welcome to chest-tracker', 'Bienvenido a chest-tracker'}" />
      <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Classes="muted"
                 Text="{ui:Tr 'Counts every chest you open, dig up or break, from the replays Fortnite saves.', 'Cuenta cada cofre que abres, desentierras o rompes, a partir de las repeticiones que guarda Fortnite.'}" />
    </StackPanel>

    <Border Classes="card" Padding="14,12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Classes="step"><TextBlock Text="1" /></Border>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock FontWeight="SemiBold" Text="{ui:Tr 'Turn on replays in Fortnite', 'Activa las repeticiones en Fortnite'}" />
          <TextBlock Classes="small" TextWrapping="Wrap"
                     Text="{ui:Tr 'Settings → Game → Replays → Record Replays: On', 'Ajustes → Juego → Repeticiones → Grabar repeticiones: Activado'}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="card" Padding="14,12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Classes="step"><TextBlock Text="2" /></Border>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                     Text="{ui:Tr 'Where is your “Open treasure chests” quest now?', '¿En cuánto va tu misión “Abre cofres de tesoro”?'}" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <NumericUpDown x:Name="QuestBox" Width="140" Minimum="0" Maximum="1000000" Increment="1"
                           FormatString="N0" ParsingNumberStyle="Number" ClipValueToMinMax="True" />
            <TextBlock Grid.Column="1" x:Name="QuestInfo" Classes="small" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="card" Padding="14,12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Classes="step"><TextBlock Text="3" /></Border>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock FontWeight="SemiBold" Text="{ui:Tr 'Start with Windows', 'Iniciar con Windows'}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ToggleSwitch x:Name="AutostartSwitch" />
            <TextBlock Classes="small" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{ui:Tr 'Waits in the tray; the overlay appears with Fortnite', 'Espera en la bandeja; el overlay aparece con Fortnite'}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
      <ComboBox x:Name="LanguageBox" Width="140">
        <ComboBoxItem>English</ComboBoxItem>
        <ComboBoxItem>Español</ComboBoxItem>
      </ComboBox>
      <Button Grid.Column="2" x:Name="StartButton" Classes="accent" Padding="20,8" FontWeight="SemiBold"
              Content="{ui:Tr 'Start tracking', 'Empezar'}" />
    </Grid>
  </StackPanel>
</UserControl>
